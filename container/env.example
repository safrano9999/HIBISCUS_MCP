#required: Jameica master password
#secret
HIBISCUS_STORE_PASSWORD=example: openssl rand -hex 32

# Optional client-facing MCP gateway bearer. Skip for direct bearer passthrough.
#secret
HIBISCUS_MCP_GATEWAY=example: openssl rand -hex 32

#required: Hibiscus credential used by MCP in gateway mode; must match the Jameica master password
#secret
HIBISCUS_MCP_BEARER=
