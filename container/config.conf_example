#default-preset: 8080
#required: Hibiscus web and XML-RPC port
HIBISCUS_PORT=8080

#default-preset: https://127.0.0.1:8080
#required: Internal Hibiscus endpoint used by the integrated MCP
HIBISCUS_MCP_UPSTREAM_URL=https://127.0.0.1:8080

#default-preset: 8000
#required: Streamable HTTP MCP port
HIBISCUS_MCP_PORT=8000
