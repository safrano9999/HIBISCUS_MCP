[Unit]
Description=Jameica Hibiscus Server
After=network.target
PartOf=hibiscus.target

[Service]
Type=simple
User=hibiscus
Group=hibiscus
WorkingDirectory=/usr/local/hibiscus
Environment=HOME=/var/lib/hibiscus
PassEnvironment=HIBISCUS_STORE_PASSWORD JAVA_TOOL_OPTIONS TZ
ExecStartPre=+/usr/bin/install -d -o hibiscus -g hibiscus -m 0700 /var/lib/hibiscus/.jameica
ExecStartPre=+/usr/bin/install -d -o hibiscus -g hibiscus -m 0750 /usr/local/hibiscus/cfg
ExecStartPre=+/usr/bin/cp -a --no-clobber /usr/share/hibiscus/cfg/. /usr/local/hibiscus/cfg/
ExecStartPre=+/usr/bin/chown -R hibiscus:hibiscus /var/lib/hibiscus/.jameica /usr/local/hibiscus/cfg
ExecStart=/usr/bin/java -Djava.net.preferIPv4Stack=true -Duser.home=/var/lib/hibiscus -Xmx1024m -jar /usr/local/hibiscus/jameica-linux64.jar -d -p ${HIBISCUS_STORE_PASSWORD}
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true

[Install]
WantedBy=hibiscus.target
