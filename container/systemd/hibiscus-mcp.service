[Unit]
Description=Hibiscus MCP gateway
After=hibiscus.service
Wants=hibiscus.service
PartOf=hibiscus.target

[Service]
Type=simple
User=hibiscus-mcp
Group=hibiscus-mcp
WorkingDirectory=/opt/hibiscus-mcp
Environment=HOME=/var/lib/hibiscus-mcp
Environment=NODE_ENV=production
PassEnvironment=HIBISCUS_MCP_GATEWAY HIBISCUS_MCP_BEARER HIBISCUS_MCP_HOST HIBISCUS_MCP_PORT HIBISCUS_MCP_UPSTREAM_URL
ExecStart=/usr/bin/node /opt/supergateway/dist/index.js --stdio "/usr/bin/node /opt/hibiscus-mcp/server.mjs" --outputTransport streamableHttp --stateful --host ${HIBISCUS_MCP_HOST} --port ${HIBISCUS_MCP_PORT} --streamableHttpPath /mcp --healthEndpoint /healthz --sessionTimeout 3600000 --logLevel info
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true

[Install]
WantedBy=hibiscus.target
