diff --git a/src/lib/requestBearer.ts b/src/lib/requestBearer.ts
new file mode 100644
index 0000000..8009b2d
--- /dev/null
+++ b/src/lib/requestBearer.ts
@@ -0,0 +1,15 @@
+import type { Request } from 'express'
+import type { ChildCommand } from './childCommand.js'
+import type { ServerSource } from './serverSource.js'
+
+export const requestBearer = (req: Request): string =>
+  (req.header('authorization') ?? '').match(/^Bearer\s+(.+)$/i)?.[1]?.trim() ?? ''
+
+export function withRequestBearer(command: ChildCommand, req: Request): ChildCommand {
+  const source = typeof command === 'string' ? { stdio: command } : command
+  return { ...source, env: { ...source.env, HIBISCUS_MCP_REQUEST_BEARER: requestBearer(req) } }
+}
+
+export function requestSource(source: ServerSource, req: Request): ServerSource {
+  return source.stdioCmd === undefined ? source : { ...source, stdioCmd: withRequestBearer(source.stdioCmd, req) }
+}
