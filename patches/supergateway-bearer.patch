@@ -93,0 +94,20 @@ export async function stdioToStatefulStreamableHttp(
+  const sessionTokens: { [sessionId: string]: string } = {}
+
+  const bearerToken = (req: express.Request) => {
+    const authorization = req.header('authorization') ?? ''
+    const match = authorization.match(/^Bearer\s+(.+)$/i)
+    return match?.[1]?.trim() ?? ''
+  }
+
+  const authorizeSession = (
+    req: express.Request,
+    res: express.Response,
+    sessionId: string,
+  ) => {
+    const token = bearerToken(req)
+    if (!token || sessionTokens[sessionId] !== token) {
+      res.status(401).send('Unauthorized')
+      return false
+    }
+    return true
+  }
